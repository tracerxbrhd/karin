{
  "app-id": "io.github.tracerxbrhd.Karin",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "karin",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/karin/cargo-home"
    }
  },
  "modules": [
    {
      "name": "karin",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --offline --locked --no-default-features",
        "install -Dm755 target/release/karin /app/bin/karin",
        "install -Dm644 packaging/io.github.tracerxbrhd.Karin.desktop /app/share/applications/io.github.tracerxbrhd.Karin.desktop",
        "install -Dm644 packaging/icons/io.github.tracerxbrhd.Karin.svg /app/share/icons/hicolor/scalable/apps/io.github.tracerxbrhd.Karin.svg",
        "install -Dm644 LICENSE /app/share/licenses/karin/LICENSE",
        "install -Dm644 docs/LICENSING.md /app/share/licenses/karin/LICENSING.md",
        "install -d /app/share/licenses/karin/third-party",
        "cp -a third-party-notices/. /app/share/licenses/karin/third-party/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../build/flatpak-source"
        }
      ]
    }
  ]
}

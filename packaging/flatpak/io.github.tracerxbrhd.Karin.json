{
  "app-id": "io.github.tracerxbrhd.Karin",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "karin",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--own-name=org.mpris.MediaPlayer2.io.github.tracerxbrhd.Karin",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--metadata=Session Bus Policy=org.kde.plasmashell=see",
    "--filesystem=xdg-run/discord-ipc-0:ro",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/karin/cargo-home"
    }
  },
  "modules": [
    {
      "name": "karin",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --offline --locked --no-default-features --features browser-session-auth",
        "install -Dm755 target/release/karin /app/bin/karin",
        "python3 packaging/release/rust_runtime.py --binary target/release/karin --output /app/share/licenses/io.github.tracerxbrhd.Karin/rust-runtime",
        "install -Dm644 packaging/io.github.tracerxbrhd.Karin.desktop /app/share/applications/io.github.tracerxbrhd.Karin.desktop",
        "install -Dm644 packaging/io.github.tracerxbrhd.Karin.metainfo.xml /app/share/metainfo/io.github.tracerxbrhd.Karin.metainfo.xml",
        "install -d /app/share/icons",
        "cp -r packaging/icons/hicolor /app/share/icons/",
        "install -Dm644 LICENSE /app/share/licenses/io.github.tracerxbrhd.Karin/LICENSE",
        "install -Dm644 docs/LICENSING.md /app/share/licenses/io.github.tracerxbrhd.Karin/LICENSING.md",
        "install -d /app/share/licenses/io.github.tracerxbrhd.Karin/third-party",
        "cp -a third-party-notices/. /app/share/licenses/io.github.tracerxbrhd.Karin/third-party/",
        "cp -a packaging/third-party-licenses/. /app/share/licenses/io.github.tracerxbrhd.Karin/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../build/flatpak-source"
        }
      ]
    }
  ]
}
